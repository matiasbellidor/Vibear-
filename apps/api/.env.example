# Copy to .env. Free plan: https://serpapi.com (no key = detection works, search answers 503).
SERPAPI_API_KEY=
SERPAPI_COUNTRY=ar
SERPAPI_HL=es-419
SEARCH_CACHE_HOURS=72

# Swap models without touching code.
CLIP_MODEL=patrickjohncyh/fashion-clip
YOLO_REPO=Bingsu/adetailer
YOLO_FILE=deepfashion2_yolov8s-seg.pt
DETECT_CONFIDENCE=0.35

CORS_ORIGINS=["http://localhost:3000"]
