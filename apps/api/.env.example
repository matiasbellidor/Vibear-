# Copy to .env (`npm run setup` does it). Free key: https://serpapi.com
# With a key, search uses Google Lens. Without one, DEMO_SEARCH=true ranks a bundled catalog of
# freely licensed garment crops instead, so the whole UI works offline; DEMO_SEARCH=false makes
# search answer 503. The perfumery reads Argentine shops directly and doesn't need the key.
SERPAPI_API_KEY=
DEMO_SEARCH=true
SERPAPI_COUNTRY=ar
SERPAPI_HL=es-419
SEARCH_CACHE_HOURS=72

# Models, downloaded from the Hugging Face Hub on first start (HF_HOME sets the cache). Swap them
# without touching code.
CLIP_MODEL=patrickjohncyh/fashion-clip
YOLO_REPO=Bingsu/adetailer
YOLO_FILE=deepfashion2_yolov8s-seg.pt
# Shoes, bags, glasses, hats, belts, watches, scarves (MIT).
ACCESSORY_REPO=valentinafeve/yolos-fashionpedia
# Body keypoints for the fitting room.
POSE_REPO=Ultralytics/YOLO11
POSE_FILE=yolo11n-pose.pt
DETECT_CONFIDENCE=0.35

# Where photos, looks, the search cache and the anonymous closets and profiles are kept.
DATA_DIR=data
MAX_UPLOAD_MB=10
CORS_ORIGINS=["http://localhost:3000"]
