# Copy to .env (`npm run setup` does it). Free key: https://serpapi.com
# With a key, search uses Google Lens. Without one, DEMO_SEARCH=true returns your own uploaded
# photos as fake "products" so the whole UI works offline; DEMO_SEARCH=false makes search answer 503.
SERPAPI_API_KEY=
DEMO_SEARCH=true
SERPAPI_COUNTRY=ar
SERPAPI_HL=es-419
SEARCH_CACHE_HOURS=72

# Swap models without touching code.
CLIP_MODEL=patrickjohncyh/fashion-clip
YOLO_REPO=Bingsu/adetailer
YOLO_FILE=deepfashion2_yolov8s-seg.pt
DETECT_CONFIDENCE=0.35

CORS_ORIGINS=["http://localhost:3000"]
