{
  "name": "vibear",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently --kill-others-on-fail -n api,web,warm -c gray,blue,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:warm\"",
    "dev:api": "node scripts/api.mjs dev",
    "dev:web": "npm run dev -w apps/web",
    "dev:warm": "node scripts/warm.mjs",
    "preview": "npm run build -w apps/web && concurrently --kill-others-on-fail -n api,web -c gray,blue \"npm:dev:api\" \"npm run start -w apps/web\"",
    "test:api": "node scripts/api.mjs test",
    "check": "npm run test:api && npm run check -w apps/web",
    "photos": "node scripts/api.mjs photos"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=20.9"
  }
}
